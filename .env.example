# Copia como .env. Nunca publiques .env ni data/.
NODE_ENV=development
HOST=127.0.0.1
PORT=5173
DATABASE_PATH=data/usuarios.sqlite
# Registra tu cuenta y ejecuta: npm run admin:set -- tu-correo@ejemplo.com
# El comando rellena ambos valores con una cuenta existente. Vacíos = sin administrador.
ADMIN_EMAIL=
ADMIN_USER_ID=

# Para futuros correos: origen HTTPS de tu dominio público, sin rutas ni credenciales.
# Dejar vacío hasta disponer del dominio real. No activa envíos.
APP_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=recuperatupoderinterior.oficial@gmail.com
SMTP_PASS=

# Mantener false hasta activar expresamente la aplicación.
APP_WRITES_ENABLED=false

# PostgreSQL privado; configurar localmente sin parámetros SSL en la URL.
DATABASE_URL=
